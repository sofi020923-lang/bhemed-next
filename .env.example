# Variables de entorno para BHEMED

# Supabase - Authentication (opcional, para producción)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase - Database (para PostgreSQL remoto)
DATABASE_URL=postgresql://user:password@localhost:5432/bhemed_db

# SQLite local (BHEMED local)
DATABASE_URL=file:./local.db

# Tailwind CSS
NODE_ENV=production
BASE_URL=http://localhost:3000

# Notistack (notificaciones)
NOTIFY_SUPABASE_TOKEN=

# Login
SUPABASE_USERNAME=
SUPABASE_PASSWORD=

# Email para recuperación
SUPABASE_EMAIL=

# Recordatorios push
NOTIFY_PUSH=true

# Recordatorios email
NOTIFY_EMAIL=true

# Sonidos recordatorios
RECORDATORIOS_SONIDOS=true

# Zona horaria
ZONE_HORARIA=America/Mexico_City