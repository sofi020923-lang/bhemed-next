# Variables de entorno para BHEMED — Neon PostgreSQL + Neon Auth + Neon Object Storage
# Copia este archivo a .env.local y completa los valores.
# Genera DATABASE_URL, NEON_AUTH_* y AWS_* con la CLI de Neon: `neon deploy`.

# Neon PostgreSQL (conexión pooled)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET= # openssl rand -base64 32 (mínimo 32 caracteres)

# Neon Object Storage (fotografías de medicamentos)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
NEON_STORAGE_BUCKET=bhemed-medicamentos
