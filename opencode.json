{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "diana-code",
  "agent": {
    "diana-code": {
      "description": "Agente principal de BHEMED. Planifica tareas complejas y espera confirmación; las sencillas las hace directo.",
      "mode": "primary"
    }
  },
  "mcp": {
    "Neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}